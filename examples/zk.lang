-- The verifier rows (test/eval/expect.txt): 1 is flagYes, 0 is flagNo.
-- bitBad verifies the bit 1 proof against the bit 0 commitment. rangeBad has e0 + 1 in the bit 0 row.
def commitKA : Prod U256 U256 := commitWords (pair 7u 11u)
def schnorrOk : Flag := schnorrVerify cKA schnorrKA
def schnorrBad : Flag := schnorrVerify cKA schnorrKABad
def bitOk0 : Flag := bitVerify c0 bitProof0
def bitOk1 : Flag := bitVerify c1 bitProof1
def bitBad : Flag := bitVerify c0 bitProof1
def rangeOk : Flag := rangeVerify cKA (pair rangeOpen rangeList)
def rangeBad : Flag := rangeVerify cKA (pair rangeOpen rangeListBad)
-- (1, 1) is not on the curve: ecAdd traps (the bn254.lang addBad shape, an entry Nat -> Flag).
def commitBad : Nat -> Flag := fun (n : Nat) => u256Eq (first (ecAdd (pair 1u 1u) (ecMul zkH (toU256 n)))) 0u

-- The steps on the S7 ledger shape (examples/ledger.lang: admit and exit). Each address holds a status
-- word (0 Empty, 1 Active, 2 Forfeited), the commitment words (cx, cy) and a deadline (0 is no deadline).
-- A non-member or a Forfeited position reverts in zkBorrow, zkRepay and zkLiquidate. The entry parameters are
-- scalars: the range proof is a chain of 32 zkRangeBit steps over the Horner accumulator (accx, accy) and the
-- bit count (Part 4): zkBorrow starts the phase, zkRangeDone closes it when the accumulator is the commitment.
state State := makeState (members : Map Addr Flag) (status : Map Addr Nat) (cx : Map Addr U256) (cy : Map Addr U256) (deadline : Map Addr Nat) (accx : Map Addr U256) (accy : Map Addr U256) (bits : Map Addr Nat) (ranged : Map Addr Flag) (poll : Nat) (cand : Addr) (ayes : Nat) (nays : Nat) (nmem : Nat) (voted : Map Addr Nat)
-- S10 Part 5: aa is the founder, the first member (Active, nmem 1). No poll is open.
def init : State := makeState (mapSet mapEmpty 0x00000000000000000000000000000000000000aa flagYes) (mapSet mapEmpty 0x00000000000000000000000000000000000000aa 1) mapEmpty mapEmpty mapEmpty mapEmpty mapEmpty mapEmpty mapEmpty 0 0x0000000000000000000000000000000000000000 0 0 1 mapEmpty
def zkGrace : Nat := 7

-- View: a is a member and its position is Active.
def zkPosActive : (env : Env) -> (s : State) -> (a : Addr) -> Flag :=
  fun (env : Env) (s : State) (a : Addr) => zkAnd (mapGet (members s) a) (natEq (mapGet (status s) a) 1)

-- The BN254 group order q. Reduce before subtracting: u256Sub saturates above q,
-- while ecMul accepts all U256 scalars and reduces them modulo q.
def zkOrder : U256 := 21888242871839275222246405745257275088548364400416034343698204186575808495617u

def zkNegScalar : U256 -> U256 :=
  fun (x : U256) => u256Sub zkOrder (u256AddMod x 0u zkOrder)

-- Only cancellation to the identity clears the deadline. Partial and zero repays
-- keep it, including a nonzero commitment whose range proof is being rebuilt.
def zkRepayDeadline : (c : Prod U256 U256) -> Nat -> Nat :=
  fun (c : Prod U256 U256) (previous : Nat) =>
    flagIf (zkAnd (u256Eq (first c) 0u) (u256Eq (second c) 0u)) 0 previous

-- The commitment of a moved by the public delta d with the blinding r: c(a) (+) commitWords (pair d r).
def zkShift : (s : State) -> (a : Addr) -> (d : U256) -> (r : U256) -> Prod U256 U256 :=
  fun (s : State) (a : Addr) (d : U256) (r : U256) => ecAdd (pair (mapGet (cx s) a) (mapGet (cy s) a)) (commitWords (pair d r))

-- S10 Part 5, the governed admit (PLAN section 7, vote and amend): one poll at a time, one candidate in
-- each poll. cand = the zero address is no open poll.
def zkNoAddr : Addr := 0x0000000000000000000000000000000000000000

-- Entry: a member opens the poll on the admit of a (admitOne at zkAmend). It reverts when the caller is not
-- a member, a poll is open, a is the zero address or a member, or a is Forfeited with an open loan (status
-- 2 and deadline >= 1, a liquidated position): the ledger cannot readmit a Forfeited holder. After zkDepart
-- with no open loan (deadline 0), a member can propose a again.
def zkPropose : (env : Env) -> (s : State) -> (a : Addr) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (a : Addr) =>
    flagIf (zkAnd (mapGet (members s) (caller env)) (addrEq (cand s) zkNoAddr))
      (flagIf (addrEq a zkNoAddr) none
        (flagIf (mapGet (members s) a) none
          (flagIf (zkAnd (natEq (mapGet (status s) a) 2) (natLe 1 (mapGet (deadline s) a)))
            none
            (some (pair (makeState (members s) (status s) (cx s) (cy s) (deadline s) (accx s) (accy s) (bits s) (ranged s) (poll s) a (ayes s) (nays s) (nmem s) (voted s)) nil)))))
      none

-- Entry: the caller exits (exitOne): not a member, Forfeited, nmem - 1. A non-member reverts. Only the caller
-- can exit (S10 Part 5: the old zkDepart took any address and forfeited it). An exit while a poll is open is
-- accepted: a vote that the caller cast stays, and nmem drops.
def zkDepart : (env : Env) -> (s : State) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) =>
    flagIf (mapGet (members s) (caller env))
      (some (pair (makeState (mapSet (members s) (caller env) flagNo) (mapSet (status s) (caller env) 2) (cx s) (cy s) (deadline s) (accx s) (accy s) (bits s) (ranged s) (poll s) (cand s) (ayes s) (nays s) (natSub (nmem s) 1) (voted s)) nil))
      none

-- Entry: the caller is a member and Active: the commitment moves by the public delta d with the blinding r
-- to c (+) commitWords (pair d r) (zkShift, the zkBorrowL step of the ledger), and the deadline is
-- now + zkGrace. From the identity (0, 0), zkBorrow 7u 11u stores cKA. Else revert.
def zkBorrow : (env : Env) -> (s : State) -> (d : U256) -> (r : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (d : U256) (r : U256) =>
    flagIf (zkPosActive env s (caller env))
      (some (pair (makeState (members s) (status s) (mapSet (cx s) (caller env) (first (zkShift s (caller env) d r))) (mapSet (cy s) (caller env) (second (zkShift s (caller env) d r))) (mapSet (deadline s) (caller env) (natAdd (now env) zkGrace)) (mapSet (accx s) (caller env) 0u) (mapSet (accy s) (caller env) 0u) (mapSet (bits s) (caller env) 0) (mapSet (ranged s) (caller env) flagNo) (poll s) (cand s) (ayes s) (nays s) (nmem s) (voted s)) nil))
      none

-- Entry: the same test; the commitment moves back by d to c (-) commitWords (pair d r), computed as
-- c (+) commitWords (pair (zkNegScalar d) (zkNegScalar r)) (the zkRepayL step).
-- Only a result at the identity clears the deadline; every other result keeps it.
-- A repay above the debt wraps mod q where the ledger saturates at 0u: the payer loses the excess, and no
-- 32-bit range chain opens the result. The replaced commitment's range attestation and any partial range
-- proof are cleared, just as in zkBorrow.
def zkRepay : (env : Env) -> (s : State) -> (d : U256) -> (r : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (d : U256) (r : U256) =>
    flagIf (zkPosActive env s (caller env))
      (some (pair
        ((fun (c : Prod U256 U256) => makeState (members s) (status s) (mapSet (cx s) (caller env) (first c)) (mapSet (cy s) (caller env) (second c)) (mapSet (deadline s) (caller env) (zkRepayDeadline c (mapGet (deadline s) (caller env)))) (mapSet (accx s) (caller env) 0u) (mapSet (accy s) (caller env) 0u) (mapSet (bits s) (caller env) 0) (mapSet (ranged s) (caller env) flagNo) (poll s) (cand s) (ayes s) (nays s) (nmem s) (voted s))
          (zkShift s (caller env) (zkNegScalar d) (zkNegScalar r)))
        nil))
      none

-- Entry: a is a member and Active with a deadline, and now is past the deadline (O17): Forfeited. Else revert.
def zkLiquidate : (env : Env) -> (s : State) -> (a : Addr) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (a : Addr) =>
    flagIf (zkAnd (zkPosActive env s a) (zkAnd (natLe 1 (mapGet (deadline s) a)) (natLe (natAdd (mapGet (deadline s) a) 1) (now env))))
      (some (pair (makeState (members s) (mapSet (status s) a 2) (cx s) (cy s) (deadline s) (accx s) (accy s) (bits s) (ranged s) (poll s) (cand s) (ayes s) (nays s) (nmem s) (voted s)) nil))
      none

-- Entry (Part 4): one bit of the range proof of the caller's commitment. The caller is Active with fewer than
-- 32 bits and the bit proof opens (cxi, cyi) as a bit: the accumulator takes the Horner step
-- acc := C_i + 2 acc (the zkRangeStep of the prelude) and the count grows by one. Else revert. The accumulator
-- starts at (0, 0), the point at infinity: the host and the 0x06/0x07 precompiles take it as the identity.
-- The call order is the fold order, rb31 (the top bit) first and rb00 last.
def zkRangeBit : (env : Env) -> (s : State) -> (cxi : U256) -> (cyi : U256) -> (a0x : U256) -> (a0y : U256) -> (a1x : U256) -> (a1y : U256) -> (e0 : U256) -> (e1 : U256) -> (s0 : U256) -> (s1 : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (cxi : U256) (cyi : U256) (a0x : U256) (a0y : U256) (a1x : U256) (a1y : U256) (e0 : U256) (e1 : U256) (s0 : U256) (s1 : U256) =>
    flagIf (zkAnd (zkPosActive env s (caller env)) (natLe (natAdd (mapGet (bits s) (caller env)) 1) 32))
      (flagIf (bitVerify (pair cxi cyi) (pair (pair (pair a0x a0y) (pair a1x a1y)) (pair (pair e0 e1) (pair s0 s1))))
        (some (pair (makeState (members s) (status s) (cx s) (cy s) (deadline s) (mapSet (accx s) (caller env) (first (ecAdd (pair cxi cyi) (ecMul (pair (mapGet (accx s) (caller env)) (mapGet (accy s) (caller env))) 2u)))) (mapSet (accy s) (caller env) (second (ecAdd (pair cxi cyi) (ecMul (pair (mapGet (accx s) (caller env)) (mapGet (accy s) (caller env))) 2u)))) (mapSet (bits s) (caller env) (natAdd (mapGet (bits s) (caller env)) 1)) (ranged s) (poll s) (cand s) (ayes s) (nays s) (nmem s) (voted s)) nil))
        none)
      none

-- Entry (Part 4): the end of the range phase. The caller is Active with 32 bits and the accumulator is the
-- commitment (cx, cy): ranged is set, the accumulator and the count reset. Else revert (a short count or a
-- wrong sum). The prelude name zkRangeEnd is the fold form, so the entry is zkRangeDone.
def zkRangeDone : (env : Env) -> (s : State) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) =>
    flagIf (zkAnd (zkPosActive env s (caller env)) (zkAnd (natEq (mapGet (bits s) (caller env)) 32) (zkAnd (u256Eq (mapGet (accx s) (caller env)) (mapGet (cx s) (caller env))) (u256Eq (mapGet (accy s) (caller env)) (mapGet (cy s) (caller env))))))
      (some (pair (makeState (members s) (status s) (cx s) (cy s) (deadline s) (mapSet (accx s) (caller env) 0u) (mapSet (accy s) (caller env) 0u) (mapSet (bits s) (caller env) 0) (mapSet (ranged s) (caller env) flagYes) (poll s) (cand s) (ayes s) (nays s) (nmem s) (voted s)) nil))
      none

-- Views (Part 4): the known answers on the chain. The words are parameters, so the curve ops stay open and
-- lower to the 0x06/0x07 precompiles (a closed call folds in the host and tests nothing on the chain).
def zkCommitX : (env : Env) -> (s : State) -> (p : U256) -> (b : U256) -> U256 :=
  fun (env : Env) (s : State) (p : U256) (b : U256) => first (commitWords (pair p b))
def zkCommitY : (env : Env) -> (s : State) -> (p : U256) -> (b : U256) -> U256 :=
  fun (env : Env) (s : State) (p : U256) (b : U256) => second (commitWords (pair p b))
def zkSchnorrView : (env : Env) -> (s : State) -> (x : U256) -> (y : U256) -> (ax : U256) -> (ay : U256) -> (s1 : U256) -> (s2 : U256) -> Flag :=
  fun (env : Env) (s : State) (x : U256) (y : U256) (ax : U256) (ay : U256) (s1 : U256) (s2 : U256) => schnorrVerify (pair x y) (pair (pair ax ay) (pair s1 s2))
def zkBitView : (env : Env) -> (s : State) -> (bx : U256) -> (by : U256) -> (a0x : U256) -> (a0y : U256) -> (a1x : U256) -> (a1y : U256) -> (e0 : U256) -> (e1 : U256) -> (s0 : U256) -> (s1 : U256) -> Flag :=
  fun (env : Env) (s : State) (bx : U256) (by : U256) (a0x : U256) (a0y : U256) (a1x : U256) (a1y : U256) (e0 : U256) (e1 : U256) (s0 : U256) (s1 : U256) => bitVerify (pair bx by) (pair (pair (pair a0x a0y) (pair a1x a1y)) (pair (pair e0 e1) (pair s0 s1)))

-- Entry: a member votes once in the open poll: c = 1 is yes, c = 0 is no, else revert. voted holds poll + 1.
-- Votes are public (the caller signs the transaction): no voter anonymity before O12 (a).
def zkVote : (env : Env) -> (s : State) -> (c : Nat) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (c : Nat) =>
    flagIf (zkAnd (mapGet (members s) (caller env)) (natLe c 1))
      (flagIf (addrEq (cand s) zkNoAddr) none
        (flagIf (natEq (mapGet (voted s) (caller env)) (natAdd (poll s) 1)) none
          (some (pair (makeState (members s) (status s) (cx s) (cy s) (deadline s) (accx s) (accy s) (bits s) (ranged s) (poll s) (cand s) (natAdd (ayes s) c) (natAdd (nays s) (natSub 1 c)) (nmem s) (mapSet (voted s) (caller env) (natAdd (poll s) 1))) nil))))
      none

-- Entry: the amend of the open poll. 2 ayes > nmem admits the candidate (admitOne: member, Active, nmem + 1);
-- else 2 nays >= nmem rejects it; else revert. Both close the poll: poll + 1, no candidate, the counts 0.
def zkAmend : (env : Env) -> (s : State) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) =>
    flagIf (addrEq (cand s) zkNoAddr) none
      (flagIf (natLe (natAdd (nmem s) 1) (natAdd (ayes s) (ayes s)))
        (some (pair (makeState (mapSet (members s) (cand s) flagYes) (mapSet (status s) (cand s) 1) (cx s) (cy s) (deadline s) (accx s) (accy s) (bits s) (ranged s) (natAdd (poll s) 1) zkNoAddr 0 0 (natAdd (nmem s) 1) (voted s)) nil))
        (flagIf (natLe (nmem s) (natAdd (nays s) (nays s)))
          (some (pair (makeState (members s) (status s) (cx s) (cy s) (deadline s) (accx s) (accy s) (bits s) (ranged s) (natAdd (poll s) 1) zkNoAddr 0 0 (nmem s) (voted s)) nil))
          none))

-- View: isMember (PLAN section 7).
def zkIsMember : (env : Env) -> (s : State) -> (a : Addr) -> Flag :=
  fun (env : Env) (s : State) (a : Addr) => mapGet (members s) a

-- Review regressions for proof bounds and scalar encodings.
def emptyOpen : SchnorrProof := pair (pair 3375067998069891636219788075293155034804894088561886047966428878849990394930u 3922351410060594331739905335299836702423744189148923529681436267396531681325u) (pair 8597939669460251328005049418096605809333994177893183986842015191416319236139u 14442140385795087337370935168415348143435625911770867638322334190322826756107u)
def longOpen : SchnorrProof := pair (pair 12481974992678856684997619298259883807046249612108435357915576320849746593354u 14800224360086191448480741491418910132648582406484314106903808813137883848319u) (pair 1362135435069791202726334692763951930217222472476157667328415839280260041673u 6155855252688236025863932138628496123297903703743282685169240071855116288935u)
def longCommit : Prod U256 U256 := pair 12448011222036054746499320310152178036189247734825768237896420791879009804573u 6902799010728819293637015386916051883258041211868508289366162948461814977607u
def rangeEmpty : Flag := rangeVerify (pair 0u 0u) (pair emptyOpen nil)
def rangeLongList : List RangeBit := fold (fun (x : RangeBit) (xs : List RangeBit) => cons x xs) (cons (pair c1 bitProof1) nil) rangeList
def rangeLong : Flag := rangeVerify longCommit (pair longOpen rangeLongList)
def schnorrScalar1 : Flag := schnorrVerify cKA (pair (first schnorrKA) (pair (u256Add (first (second schnorrKA)) r) (second (second schnorrKA))))
def schnorrScalar2 : Flag := schnorrVerify cKA (pair (first schnorrKA) (pair (first (second schnorrKA)) (u256Add (second (second schnorrKA)) r)))
def bitChallenge0 : Flag := bitVerify c0 (pair (first bitProof0) (pair (pair (u256Add (first (first (second bitProof0))) r) (second (first (second bitProof0)))) (second (second bitProof0))))
def bitChallenge1 : Flag := bitVerify c0 (pair (first bitProof0) (pair (pair (first (first (second bitProof0))) (u256Add (second (first (second bitProof0))) r)) (second (second bitProof0))))
def bitScalar0 : Flag := bitVerify c0 (pair (first bitProof0) (pair (first (second bitProof0)) (pair (u256Add (first (second (second bitProof0))) r) (second (second (second bitProof0))))))
def bitScalar1 : Flag := bitVerify c0 (pair (first bitProof0) (pair (first (second bitProof0)) (pair (first (second (second bitProof0))) (u256Add (second (second (second bitProof0))) r))))

-- A completed range proof of cKA, followed by a partial repay (5u, 5u).
def reviewAddr : Addr := 0x00000000000000000000000000000000000000aa
def reviewEnv : Env := makeEnv 1 reviewAddr
def reviewRangedState : State := makeState (mapSet mapEmpty reviewAddr flagYes) (mapSet mapEmpty reviewAddr 1) (mapSet mapEmpty reviewAddr (first cKA)) (mapSet mapEmpty reviewAddr (second cKA)) (mapSet mapEmpty reviewAddr 8) mapEmpty mapEmpty mapEmpty (mapSet mapEmpty reviewAddr flagYes) 0 0x0000000000000000000000000000000000000000 0 0 1 mapEmpty
def repayUnranges : Flag := option flagYes (fun (p : Prod State (List Out)) => mapGet (ranged (first p)) reviewAddr) (zkRepay reviewEnv reviewRangedState 5u 5u)
-- One accepted bit of cKA, followed by a partial repay (5u, 5u) during the stream.
def reviewPartialState : State := makeState (mapSet mapEmpty reviewAddr flagYes) (mapSet mapEmpty reviewAddr 1) (mapSet mapEmpty reviewAddr (first cKA)) (mapSet mapEmpty reviewAddr (second cKA)) (mapSet mapEmpty reviewAddr 8) (mapSet mapEmpty reviewAddr (first (first rb31))) (mapSet mapEmpty reviewAddr (second (first rb31))) (mapSet mapEmpty reviewAddr 1) mapEmpty 0 0x0000000000000000000000000000000000000000 0 0 1 mapEmpty
def reviewPartialRepay : Option (Prod State (List Out)) := zkRepay reviewEnv reviewPartialState 5u 5u
def repayResetsBits : Nat := option 99 (fun (p : Prod State (List Out)) => mapGet (bits (first p)) reviewAddr) reviewPartialRepay
def repayResetsAcc : Flag := option flagNo (fun (p : Prod State (List Out)) => zkAnd (u256Eq (mapGet (accx (first p)) reviewAddr) 0u) (u256Eq (mapGet (accy (first p)) reviewAddr) 0u)) reviewPartialRepay

-- Part 5: the equivalence PrivateFace ~ PublicFace as a guest theorem (PLAN section 8, Part 5).
-- Commitment is a set (squash0), Trunc1 (zkFiber c) is a proposition (squash1) and PrivateFace is a
-- set (quotSquash). A Pi over I is refused (INTERVAL_TYPE), thus each filler is stated for its own
-- family: fiberPathP is the 1-dim filler over a path of commitments, the quotSquash case of
-- quotElimProp and the payload of isSetPublicFace are the 2-dim filler (an hcomp over a transported
-- base, the four tubes from the proposition).
def isSetCommitment : isSet Commitment :=
  fun (x : Commitment) (y : Commitment) (p : Path Commitment x y) (q : Path Commitment x y) =>
    fun (i : I) => fun (j : I) => squash0 (Prod U256 U256) x y p q i j
def isPropFiber : (c : Commitment) -> isProp (Trunc1 (zkFiber c)) :=
  fun (c : Commitment) => fun (x : Trunc1 (zkFiber c)) (y : Trunc1 (zkFiber c)) => fun (i : I) => squash1 (zkFiber c) x y i
def isSetPrivateFace : isSet PrivateFace :=
  fun (x : PrivateFace) (y : PrivateFace) (p : Path PrivateFace x y) (q : Path PrivateFace x y) =>
    fun (i : I) => fun (j : I) => quotSquash Opening R x y p q i j
-- The 1-dim filler: a PathP in the proposition family Trunc1 (zkFiber _) over a path of commitments.
def fiberPathP : (c : Commitment) -> (d : Commitment) -> (p : Path Commitment c d) -> (t0 : Trunc1 (zkFiber c)) -> (t1 : Trunc1 (zkFiber d)) ->
  PathP (fun (k : I) => Trunc1 (zkFiber (p @ k))) t0 t1 :=
  fun (c : Commitment) (d : Commitment) (p : Path Commitment c d) (t0 : Trunc1 (zkFiber c)) (t1 : Trunc1 (zkFiber d)) =>
    fun (i : I) => squash1 (zkFiber (p @ i))
      (transp (fun (k : I) => Trunc1 (zkFiber (p @ (i /\ k)))) (~i) t0)
      (transp (fun (k : I) => Trunc1 (zkFiber (p @ (i \/ ~k)))) i t1) i
-- The square of witnesses of two paths in PublicFace, by isSet Commitment.
def witSq : (x : PublicFace) -> (y : PublicFace) -> (p : Path PublicFace x y) -> (q : Path PublicFace x y) ->
  Path (Path Commitment (witness x) (witness y)) (fun (k : I) => witness (p @ k)) (fun (k : I) => witness (q @ k)) :=
  fun (x : PublicFace) (y : PublicFace) (p : Path PublicFace x y) (q : Path PublicFace x y) =>
    isSetCommitment (witness x) (witness y) (fun (k : I) => witness (p @ k)) (fun (k : I) => witness (q @ k))
-- isSet PublicFace: the witness square is witSq, the payload square is the 2-dim filler.
def isSetPublicFace : isSet PublicFace :=
  fun (x : PublicFace) (y : PublicFace) (p : Path PublicFace x y) (q : Path PublicFace x y) =>
    fun (i : I) => fun (j : I) => pack (witSq x y p q @ i @ j)
      (hcomp (Trunc1 (zkFiber (witSq x y p q @ i @ j))) (~i \/ i \/ ~j \/ j)
        (fun (m : I) => [
          ~i -> isPropFiber (witness (p @ j)) (transp (fun (k : I) => Trunc1 (zkFiber (witSq x y p q @ (i /\ k) @ (j /\ k)))) i0 (payload x)) (payload (p @ j)) @ m,
          i -> isPropFiber (witness (q @ j)) (transp (fun (k : I) => Trunc1 (zkFiber (witSq x y p q @ (i /\ k) @ (j /\ k)))) i0 (payload x)) (payload (q @ j)) @ m,
          ~j -> isPropFiber (witness x) (transp (fun (k : I) => Trunc1 (zkFiber (witSq x y p q @ (i /\ k) @ (j /\ k)))) i0 (payload x)) (payload x) @ m,
          j -> isPropFiber (witness y) (transp (fun (k : I) => Trunc1 (zkFiber (witSq x y p q @ (i /\ k) @ (j /\ k)))) i0 (payload x)) (payload y) @ m ])
        (transp (fun (k : I) => Trunc1 (zkFiber (witSq x y p q @ (i /\ k) @ (j /\ k)))) i0 (payload x)))
-- The dependent elim of PrivateFace into a proposition family: the quotEq case is the 1-dim filler,
-- the quotSquash case the 2-dim filler.
def quotElimProp : (P : PrivateFace -> Type 0) -> (h : (z : PrivateFace) -> isProp (P z)) -> (c : (o : Opening) -> P (quot Opening R o)) -> (z : PrivateFace) -> P z :=
  fun (P : PrivateFace -> Type 0) (h : (z : PrivateFace) -> isProp (P z)) (c : (o : Opening) -> P (quot Opening R o)) (z : PrivateFace) =>
    elim (fun (w : PrivateFace) => P w)
      (fun (o : Opening) => c o)
      (fun (a : Opening) (b : Opening) (r : R a b) => fun (i : I) =>
        h (quotEq Opening R a b r i)
          (transp (fun (k : I) => P (quotEq Opening R a b r (i /\ k))) (~i) (c a))
          (transp (fun (k : I) => P (quotEq Opening R a b r (i \/ ~k))) i (c b)) @ i)
      (fun (x : PrivateFace) (ihx : P x) (y : PrivateFace) (ihy : P y)
        (p : Path PrivateFace x y) (ihp : PathP (fun (j : I) => P (p @ j)) ihx ihy)
        (q : Path PrivateFace x y) (ihq : PathP (fun (j : I) => P (q @ j)) ihx ihy) =>
        fun (i : I) => fun (j : I) =>
          hcomp (P (quotSquash Opening R x y p q i j)) (~i \/ i \/ ~j \/ j)
            (fun (m : I) => [
              ~i -> h (p @ j) (transp (fun (k : I) => P (quotSquash Opening R x y p q (i /\ k) (j /\ k))) i0 ihx) (ihp @ j) @ m,
              i -> h (q @ j) (transp (fun (k : I) => P (quotSquash Opening R x y p q (i /\ k) (j /\ k))) i0 ihx) (ihq @ j) @ m,
              ~j -> h x (transp (fun (k : I) => P (quotSquash Opening R x y p q (i /\ k) (j /\ k))) i0 ihx) ihx @ m,
              j -> h y (transp (fun (k : I) => P (quotSquash Opening R x y p q (i /\ k) (j /\ k))) i0 ihx) ihy @ m ])
            (transp (fun (k : I) => P (quotSquash Opening R x y p q (i /\ k) (j /\ k))) i0 ihx))
      z
-- The dependent elim of Trunc1 (zkFiber c) into a proposition family: the squash1 case is the 1-dim filler.
def trunc1ElimProp : (c : Commitment) -> (P : Trunc1 (zkFiber c) -> Type 0) -> (h : (t : Trunc1 (zkFiber c)) -> isProp (P t)) ->
  (k : (z : zkFiber c) -> P (trunc1 (zkFiber c) z)) -> (t : Trunc1 (zkFiber c)) -> P t :=
  fun (c : Commitment) (P : Trunc1 (zkFiber c) -> Type 0) (h : (t : Trunc1 (zkFiber c)) -> isProp (P t)) (k : (z : zkFiber c) -> P (trunc1 (zkFiber c) z)) (t : Trunc1 (zkFiber c)) =>
    elim (fun (u : Trunc1 (zkFiber c)) => P u)
      (fun (z : zkFiber c) => k z)
      (fun (x : Trunc1 (zkFiber c)) (ihx : P x) (y : Trunc1 (zkFiber c)) (ihy : P y) => fun (i : I) =>
        h (squash1 (zkFiber c) x y i)
          (transp (fun (m : I) => P (squash1 (zkFiber c) x y (i /\ m))) (~i) ihx)
          (transp (fun (m : I) => P (squash1 (zkFiber c) x y (i \/ ~m))) i ihy) @ i)
      t
-- commit' is the fold of commit over the quotient; the quotEq case is r itself (R a b is a path of commitments).
def commit' : PrivateFace -> Commitment := fun (z : PrivateFace) => fold
  (fun (o : Opening) => commit o)
  (fun (a : Opening) (b : Opening) (r : R a b) => fun (i : I) => r @ i)
  (fun (x : Commitment) (y : Commitment) (p : Path Commitment x y) (q : Path Commitment x y) => fun (i : I) => fun (j : I) => isSetCommitment x y p q @ i @ j)
  z
-- forward: the witness of a point is the opening itself with refl.
def forward : PrivateFace -> PublicFace := fun (z : PrivateFace) => fold
  (fun (o : Opening) => pack (commit o) (trunc1 (zkFiber (commit o)) (pack o refl)))
  (fun (a : Opening) (b : Opening) (r : R a b) => fun (i : I) =>
    pack (r @ i) (fiberPathP (commit a) (commit b) r (trunc1 (zkFiber (commit a)) (pack a refl)) (trunc1 (zkFiber (commit b)) (pack b refl)) @ i))
  (fun (x : PublicFace) (y : PublicFace) (p : Path PublicFace x y) (q : Path PublicFace x y) => fun (i : I) => fun (j : I) => isSetPublicFace x y p q @ i @ j)
  z
-- commInj: commit' is injective, by quotEq at two points (no quotient effectiveness is needed).
def commInj : (z : PrivateFace) -> (w : PrivateFace) -> Path Commitment (commit' z) (commit' w) -> Path PrivateFace z w :=
  quotElimProp (fun (z : PrivateFace) => (w : PrivateFace) -> Path Commitment (commit' z) (commit' w) -> Path PrivateFace z w)
    (fun (z : PrivateFace) => fun (f : (w : PrivateFace) -> Path Commitment (commit' z) (commit' w) -> Path PrivateFace z w) (g : (w : PrivateFace) -> Path Commitment (commit' z) (commit' w) -> Path PrivateFace z w) =>
      fun (i : I) => fun (w : PrivateFace) => fun (e : Path Commitment (commit' z) (commit' w)) => isSetPrivateFace z w (f w e) (g w e) @ i)
    (fun (o : Opening) => quotElimProp (fun (w : PrivateFace) => Path Commitment (commit o) (commit' w) -> Path PrivateFace (quot Opening R o) w)
      (fun (w : PrivateFace) => fun (f : Path Commitment (commit o) (commit' w) -> Path PrivateFace (quot Opening R o) w) (g : Path Commitment (commit o) (commit' w) -> Path PrivateFace (quot Opening R o) w) =>
        fun (i : I) => fun (e : Path Commitment (commit o) (commit' w)) => isSetPrivateFace (quot Opening R o) w (f e) (g e) @ i)
      (fun (o' : Opening) => fun (e : Path Commitment (commit o) (commit o')) => fun (i : I) => quotEq Opening R o o' e i))
-- Sg c is the fiber of commit' at c, a proposition: the first component by commInj, the second the 1-dim filler.
def Sg : Commitment -> Type 0 := fun (c : Commitment) => Sigma (z : PrivateFace) (Path Commitment (commit' z) c)
def sgPath : (c : Commitment) -> (x : Sg c) -> (y : Sg c) -> Path PrivateFace (witness x) (witness y) :=
  fun (c : Commitment) (x : Sg c) (y : Sg c) =>
    commInj (witness x) (witness y) (trans Commitment (commit' (witness x)) c (commit' (witness y)) (payload x) (fun (k : I) => payload y @ ~k))
-- sgPathP is stated over an abstract path r, thus the checker uses the type of r and does not unfold
-- commInj inside the transp families (the session 13 probe hit the arena limit on the direct form).
def sgPathP : (c : Commitment) -> (z : PrivateFace) -> (w : PrivateFace) -> (r : Path PrivateFace z w) ->
  (pz : Path Commitment (commit' z) c) -> (pw : Path Commitment (commit' w) c) ->
  PathP (fun (k : I) => Path Commitment (commit' (r @ k)) c) pz pw :=
  fun (c : Commitment) (z : PrivateFace) (w : PrivateFace) (r : Path PrivateFace z w) (pz : Path Commitment (commit' z) c) (pw : Path Commitment (commit' w) c) =>
    fun (i : I) => isSetCommitment (commit' (r @ i)) c
      (transp (fun (k : I) => Path Commitment (commit' (r @ (i /\ k))) c) (~i) pz)
      (transp (fun (k : I) => Path Commitment (commit' (r @ (i \/ ~k))) c) i pw) @ i
def isPropSg : (c : Commitment) -> isProp (Sg c) :=
  fun (c : Commitment) => fun (x : Sg c) (y : Sg c) => fun (i : I) =>
    pack (sgPath c x y @ i) (sgPathP c (witness x) (witness y) (sgPath c x y) (payload x) (payload y) @ i)
-- backward: the fold of Trunc1 (zkFiber c) into the proposition Sg c, then the first component.
def backAt : (c : Commitment) -> Trunc1 (zkFiber c) -> Sg c := fun (c : Commitment) (t : Trunc1 (zkFiber c)) => fold
  (fun (z : zkFiber c) => pack (quot Opening R (witness z)) (payload z))
  (fun (x : Sg c) (y : Sg c) => fun (i : I) => isPropSg c x y @ i)
  t
def backward : PublicFace -> PrivateFace := fun (y : PublicFace) => witness (backAt (witness y) (payload y))
-- The round trips: at a point both sides compute, the path and square cases come from the proposition.
def roundT : (z : PrivateFace) -> Path PrivateFace (backward (forward z)) z :=
  quotElimProp (fun (z : PrivateFace) => Path PrivateFace (backward (forward z)) z)
    (fun (z : PrivateFace) => isSetPrivateFace (backward (forward z)) z)
    (fun (o : Opening) => refl)
def roundS : (y : PublicFace) -> Path PublicFace (forward (backward y)) y := fun (y : PublicFace) =>
  trunc1ElimProp (witness y)
    (fun (t : Trunc1 (zkFiber (witness y))) => Path PublicFace (forward (backward (pack (witness y) t))) (pack (witness y) t))
    (fun (t : Trunc1 (zkFiber (witness y))) => isSetPublicFace (forward (backward (pack (witness y) t))) (pack (witness y) t))
    (fun (z : zkFiber (witness y)) => fun (i : I) =>
      pack (payload z @ i) (fiberPathP (commit (witness z)) (witness y) (payload z) (trunc1 (zkFiber (commit (witness z))) (pack (witness z) refl)) (trunc1 (zkFiber (witness y)) z) @ i))
    (payload y)
def zkFaceEquiv : Equiv PrivateFace PublicFace := isoToEquiv PrivateFace PublicFace forward backward roundS roundT
def zkLoanPath : Path (Type 0) PrivateFace PublicFace := ua PrivateFace PublicFace zkFaceEquiv
-- The closed opening (7, 11): the four PLAN rows.
def openKA : Opening := pair 7u 11u
def zkForwardKA : PublicFace := forward (quot Opening R openKA)
def zkBackwardKA : PrivateFace := backward (pack (commit openKA) (trunc1 (zkFiber (commit openKA)) (pack openKA refl)))
def zkRoundTKA : Path PrivateFace (backward (forward (quot Opening R openKA))) (quot Opening R openKA) := roundT (quot Opening R openKA)
def zkRoundSKA : PublicFace := roundS (pack (commit openKA) (trunc1 (zkFiber (commit openKA)) (pack openKA refl))) @ i1
-- S10 Part 1 (PLAN 210-211). Loan is the ua path zkLoanPath read backwards: Loan @ i0 is PublicFace and
-- Loan @ i1 is PrivateFace, both by the true-key rule of Glue. The PLAN family Loan i is Loan @ i here: a
-- definition typed I -> Type 0 is refused (rule R9, a Pi over the interval), a path in Type 0 is not.
def Loan : Path (Type 0) PublicFace PrivateFace := fun (i : I) => zkLoanPath @ ~i
-- zkPrivateLoan c is Sg c with the binder typed by Loan @ i1. The design name PrivateLoan is a signature
-- name the kernel keeps (REFUSE_SIG), as zkEquiv became zkFaceEquiv. (unglue x).1 of PLAN 211 is
-- commit' x: at the true key unglue is the branch equivalence forward, and witness (forward x) = commit' x.
def zkPrivateLoan : Commitment -> Type 0 := fun (c : Commitment) => Sigma (x : Loan @ i1) (Path Commitment (commit' x) c)
-- One private loan per commitment: zkPrivateLoan c converts to Sg c, so isPropSg carries over.
def isPropZkPrivateLoan : (c : Commitment) -> isProp (zkPrivateLoan c) := fun (c : Commitment) => isPropSg c
-- The closed opening (7, 11) along Loan: the transport from i1 to i0 is the ua transport, which computes to forward.
def zkLoanKA : PublicFace := transp (fun (j : I) => Loan @ ~j) i0 (quot Opening R openKA)
-- The transport back, from i0 to i1, lands in PrivateFace.
def zkLoanBackKA : PrivateFace := transp (fun (j : I) => Loan @ j) i0 zkForwardKA
-- The holder's representative private loan at the closed opening: commit' (quot Opening R openKA) computes
-- to commit openKA, so refl fits. The pack is its own def: a term has no type ascription in this syntax.
def zkPrivateLoanPt : zkPrivateLoan (commit openKA) := pack (quot Opening R openKA) refl
def zkPrivateLoanKA : PrivateFace := witness zkPrivateLoanPt

-- S10 Part 2 (PLAN 240-242). borrow and repay are steps on the S7 ledger: the member's Active p becomes
-- Active (f p), every other holding keeps its value, and the Inv field moves by the elim on the holding.
-- liquidate is the transport along the exit path of the member (the exit case of LendingLedger): a member
-- cannot hold Forfeited, so the ledger-level liquidate leaves the member set. The design names borrow,
-- repay and liquidate are signature names the kernel keeps (REFUSE_SIG); zkBorrow, zkRepay and
-- zkLiquidate are the S9 EVM entries, so the ledger terms carry the suffix L.
def stepHolding : (f : Position -> Position) -> Holding -> Holding :=
  fun (f : Position -> Position) (h : Holding) => either (fun (p : Position) => inl (f p)) (fun (r : Sum Position Unit) => inr r) h
def stepInv : (f : Position -> Position) -> (b : Sum Unit Unit) -> (h : Holding) -> Inv b h -> Inv b (stepHolding f h) :=
  fun (f : Position -> Position) (b : Sum Unit Unit) (h : Holding) =>
    elim (fun (k : Holding) => Inv b k -> Inv b (stepHolding f k))
      (fun (p : Position) => fun (e : Inv b (inl p)) => e)
      (fun (r : Sum Position Unit) => fun (e : Inv b (inr r)) => e) h
def stepOne : (f : Position -> Position) -> (m : Agent -> Sum Unit Unit) -> Ledger m -> Ledger m :=
  fun (f : Position -> Position) (m : Agent -> Sum Unit Unit) (l : Ledger m) =>
    pack (fun (b : Agent) => either (fun (u : Unit) => witness l (inl u)) (fun (u : Unit) => stepHolding f (witness l (inr u))) b)
      (fun (b : Agent) => elim (fun (c : Agent) => Inv (m c) (either (fun (u : Unit) => witness l (inl u)) (fun (u : Unit) => stepHolding f (witness l (inr u))) c))
        (fun (u : Unit) => payload l (inl u))
        (fun (u : Unit) => stepInv f (m (inr u)) (witness l (inr u)) (payload l (inr u))) b)
def zkBorrowL : (m : Agent -> Sum Unit Unit) -> U256 -> Ledger m -> Ledger m := fun (m : Agent -> Sum Unit Unit) (d : U256) => stepOne (fun (p : Position) => u256Add p d) m
def zkRepayL : (m : Agent -> Sum Unit Unit) -> U256 -> Ledger m -> Ledger m := fun (m : Agent -> Sum Unit Unit) (d : U256) => stepOne (fun (p : Position) => u256Sub p d) m
def nobody : Agent -> Sum Unit Unit := fun (b : Agent) => inl unit
def onlyOne : Agent -> Sum Unit Unit := fun (b : Agent) => either (fun (u : Unit) => inl unit) (fun (u : Unit) => inr unit) b
def sameElseBack : (b : Agent) -> Sum (Path Agent b (inr unit)) (Path (Sum Unit Unit) (onlyOne b) (nobody b)) :=
  fun (b : Agent) => elim (fun (c : Agent) => Sum (Path Agent c (inr unit)) (Path (Sum Unit Unit) (onlyOne c) (nobody c)))
    (fun (u : Unit) => inr refl)
    (fun (u : Unit) => elim (fun (w : Unit) => Sum (Path Agent (inr w) (inr unit)) (Path (Sum Unit Unit) (onlyOne (inr w)) (nobody (inr w)))) (inl refl) u) b
def exitOne : Path Membership (memberSet onlyOne) (memberSet nobody) :=
  fun (i : I) => exit onlyOne nobody (inr unit) refl refl sameElseBack i
def zkLiquidateL : Ledger onlyOne -> Ledger nobody := fun (l : Ledger onlyOne) => transp (fun (i : I) => LendingLedger (exitOne @ i)) i0 l
-- The closed ledger: the member inr unit holds Active 7u, the agent inl unit holds Empty.
def hold7 : Agent -> Holding := fun (b : Agent) => either (fun (u : Unit) => inr (inr unit)) (fun (u : Unit) => inl 7u) b
def l7 : Ledger onlyOne :=
  pack hold7 (fun (b : Agent) => elim (fun (c : Agent) => Inv (onlyOne c) (hold7 c)) (fun (u : Unit) => unit) (fun (u : Unit) => unit) b)
def zkBorrowKA : Holding := witness (zkBorrowL onlyOne 5u l7) (inr unit)
def zkBorrowOtherKA : Holding := witness (zkBorrowL onlyOne 5u l7) (inl unit)
def zkRepayKA : Holding := witness (zkRepayL onlyOne 5u l7) (inr unit)
def zkRepayUnderKA : Holding := witness (zkRepayL onlyOne 9u l7) (inr unit)
def zkLiquidateKA : Holding := witness (zkLiquidateL l7) (inr unit)
def zkLiquidateOtherKA : Holding := witness (zkLiquidateL l7) (inl unit)
def zkRepayForfeitedKA : Holding := witness (zkRepayL nobody 5u (zkLiquidateL l7)) (inr unit)
def zkBorrowRepayKA : Holding := witness (zkRepayL onlyOne 5u (zkBorrowL onlyOne 5u l7)) (inr unit)

-- S10 Part 4, the link rows: each runs a chain entry on the review state that holds cKA and compares the
-- stored (cx, cy) with commitWords of the ledger value. 12u is zkBorrowKA, 2u is zkRepayKA and 0u is
-- zkRepayUnderKA: the ledger saturates at 0u, the chain wraps mod zkOrder (zkRepayExcessWrap).
def zkLinkAt : (o : Option (Prod State (List Out))) -> (w : Prod U256 U256) -> Flag :=
  fun (o : Option (Prod State (List Out))) (w : Prod U256 U256) => option flagNo (fun (p : Prod State (List Out)) => zkAnd (u256Eq (mapGet (cx (first p)) reviewAddr) (first w)) (u256Eq (mapGet (cy (first p)) reviewAddr) (second w))) o
def zkBorrowLink : Flag := zkLinkAt (zkBorrow reviewEnv reviewRangedState 5u 13u) (commitWords (pair 12u 24u))
def zkRepayLink : Flag := zkLinkAt (zkRepay reviewEnv reviewRangedState 5u 5u) (commitWords (pair 2u 6u))
def zkRepayExcessLink : Flag := zkLinkAt (zkRepay reviewEnv reviewRangedState 9u 5u) (commitWords (pair 0u 6u))
def zkRepayExcessWrap : Flag := zkLinkAt (zkRepay reviewEnv reviewRangedState 9u 5u) (commitWords (pair (u256Sub zkOrder 2u) 6u))
-- The membership map: zkPosActive (a member with status 1) is the ledger member set. After zkLiquidate at 9
-- the former member is outside it (zkLiquidateKA is inr (inl 7u)), and zkPropose cannot bring it back.
def reviewLateEnv : Env := makeEnv 9 reviewAddr
def reviewForfeited : Option (Prod State (List Out)) := zkLiquidate reviewLateEnv reviewRangedState reviewAddr
def zkLiquidateLink : Flag := option flagYes (fun (p : Prod State (List Out)) => zkPosActive reviewLateEnv (first p) reviewAddr) reviewForfeited
-- S10 Part 5: the member bb cannot propose aa, Forfeited with an open loan (status 2, deadline 8, not a member).
def zkProposeForfeited : Nat := option 0 (fun (e : Prod State (List Out)) => 1) (zkPropose (makeEnv 1 0x00000000000000000000000000000000000000bb) (makeState (mapSet mapEmpty 0x00000000000000000000000000000000000000bb flagYes) (mapSet mapEmpty reviewAddr 2) mapEmpty mapEmpty (mapSet mapEmpty reviewAddr 8) mapEmpty mapEmpty mapEmpty mapEmpty 0 zkNoAddr 0 0 1 mapEmpty) reviewAddr)

-- Review regressions: a nonzero commitment keeps its original liquidation deadline.
def repayZeroDeadline : Nat := option 99 (fun (p : Prod State (List Out)) => mapGet (deadline (first p)) reviewAddr) (zkRepay reviewEnv reviewRangedState 0u 0u)
def repayPartialDeadline : Nat := option 99 (fun (p : Prod State (List Out)) => mapGet (deadline (first p)) reviewAddr) reviewPartialRepay
def repayPartialLiquidates : Nat := option 99 (fun (p : Prod State (List Out)) => option 0 (fun (l : Prod State (List Out)) => 1) (zkLiquidate reviewLateEnv (first p) reviewAddr)) reviewPartialRepay
-- Scalars above q must subtract the same group element that borrow adds.
def repayLargeDelta : Flag := zkLinkAt (zkRepay reviewEnv reviewRangedState (u256Add zkOrder 1u) 5u) (commitWords (pair 6u 6u))
def repayLargeBlind : Flag := zkLinkAt (zkRepay reviewEnv reviewRangedState 5u (u256Add zkOrder 1u)) (commitWords (pair 2u 10u))
def repayFullDeadline : Nat := option 99 (fun (p : Prod State (List Out)) => mapGet (deadline (first p)) reviewAddr) (zkRepay reviewEnv reviewRangedState 7u 11u)
def repayExcessDeadline : Nat := option 99 (fun (p : Prod State (List Out)) => mapGet (deadline (first p)) reviewAddr) (zkRepay reviewEnv reviewRangedState 9u 5u)
def repayScalarRoundTrip : U256 -> U256 -> Flag :=
  fun (d : U256) (r : U256) => option flagNo (fun (p : Prod State (List Out)) => zkLinkAt (zkRepay reviewEnv (first p) d r) cKA) (zkBorrow reviewEnv reviewRangedState d r)
def repayBelowOrder : Flag := repayScalarRoundTrip (u256Sub zkOrder 1u) (u256Sub zkOrder 1u)
def repayAtOrder : Flag := repayScalarRoundTrip zkOrder zkOrder
def repayMaxScalar : Flag := repayScalarRoundTrip 115792089237316195423570985008687907853269984665640564039457584007913129639935u 115792089237316195423570985008687907853269984665640564039457584007913129639935u

